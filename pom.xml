<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.dayu.yiyibushe</groupId>
    <artifactId>yiyibushe</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>yiyibushe</name>
    <description>依依不舍 - 阿里云 OSS + DashScope 通义万相虚拟试穿服务</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <!-- 全项目统一 UTF-8，避免中文注释/控制台输出在不同平台乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 全局掏空默认的 logback 日志栈（logging starter 的全部传递依赖被排除），
                 日志实现统一切换为 Log4j2（见 spring-boot-starter-log4j2），
                 避免同一 classpath 出现多个 SLF4J 绑定。 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-logging</artifactId>
                <exclusions>
                    <exclusion>
                        <groupId>*</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webservices</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JSON 工具：FastJSON2（最新版，已修复低版本高危漏洞） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>2.0.65</version>
        </dependency>

        <!-- 阿里云 OSS Java SDK：上传/列出/下载素材图片 -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.18.1</version>
        </dependency>

        <!-- 日志实现：SLF4J 门面 + Log4j2（业务代码只用 org.slf4j.Logger，不直接依赖 log4j API）。
             默认 logback 已在 dependencyManagement 全局掏空。版本交 Spring Boot BOM 管理。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- LMAX Disruptor：Log4j2 异步日志（AsyncLogger/AsyncRoot）的底层无锁环形队列。 -->
        <dependency>
            <groupId>com.lmax</groupId>
            <artifactId>disruptor</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- RocketMQ 官方原生客户端：引入官方类型与协议栈（如 org.apache.rocketmq.common.message.Message）。
             本项目不连远程服务器：发送侧把消息体按真实 MQ 语义序列化为官方 Message（JSON body），
             本地注册、本地发送、本地消费（见 infra/mq/LocalRocketMqBroker）；
             未来接入真实集群时客户端类型与消息协议不变。 -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client</artifactId>
            <version>4.9.8</version>
        </dependency>

        <!-- JAXB（Java 17 已移除，OSS SDK 在签名计算等环节仍需要） -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>4.0.2</version>
        </dependency>

        <!-- 通用工具包底层（业务代码不直接使用，统一走 common.util 下 XxxUtilExt 封装层）。
             3.18.0 修复 CVE-2025-48924（ClassUtils.getClass 非受控递归，CVSS 5.3），不得低于该版本。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.4</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webservices-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- AgentScope HarnessAgent 核心依赖（会自动引入 agentscope-core） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- AgentScope 核心：ReActAgent、Pipeline、Msg 等 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- 模型扩展：通义千问 DashScope -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- 模型扩展：OpenAI 兼容端点（DeepSeek flash / Kimi / Moonshot 等） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- A2A Server：把本地 Agent 暴露为 HTTP 服务 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-a2a-server</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- A2A Client：调用远程 Agent -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-a2a-client</artifactId>
            <version>2.0.1</version>
        </dependency>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MySQL 驱动：Spring Boot 官方推荐仅以 runtime 引入，运行期由连接池加载。
             版本交 Spring Boot BOM 管理。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MyBatis Starter（XML 形式 Mapper）：
             4.0.x 是官方对 Spring Boot 4.x 的适配版本（内含 mybatis 3.5 / mybatis-spring 4.0），
             并自带 spring-boot-starter-jdbc 传递依赖——自动装配 HikariCP 连接池与 DataSource，
             无需再单独引 jdbc starter。版本独立于 BOM，需显式指定。 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- Flyway 数据库版本管理（Boot 4 起自动配置独立为 starter）：
             迁移脚本位于 db/migration，命名 VyyyyMMdd_HHmm__描述.sql，
             应用启动时自动执行所有未应用的脚本。版本交 Spring Boot BOM 管理。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Flyway 对 MySQL 的方言支持（Flyway 10 起数据库支持独立成模块） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
